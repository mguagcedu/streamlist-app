import React,{useEffect,useRef,useState} from "react";
import { useApp } from "../state/AppContext.jsx";
import { searchMovies, TMDB_IMG } from "../utils/tmdb.js";

export default function Movies(){
  const { API, toggleFav, favs, recent, setRecent } = useApp();
  const [q,setQ]=useState("");
  const [rows,setRows]=useState([]);
  const [loading,setLoading]=useState(false);
  const [suggest,setSuggest]=useState([]);
  const [hi,setHi]=useState(0);
  const boxRef = useRef(null);

  async function go(term){
    if(!term) return;
    setLoading(true);
    const d = await searchMovies(API, term);
    setRows(d.results||[]);
    setRecent(r=>[term, ...r.filter(x=>x!==term)].slice(0,6));
    setLoading(false);
  }

  async function onType(v){
    setQ(v);
    if(v.length<2){ setSuggest([]); return; }
    const d = await searchMovies(API, v);
    setSuggest((d.results||[]).slice(0,8));
    setHi(0);
  }

  function keyDown(e){
    if(!suggest.length){
      if(e.key==="Enter") go(q);
      return;
    }
    if(e.key==="ArrowDown"){ e.preventDefault(); setHi(h=>Math.min(h+1, suggest.length-1)); }
    if(e.key==="ArrowUp"){   e.preventDefault(); setHi(h=>Math.max(h-1, 0)); }
    if(e.key==="Enter"){     e.preventDefault(); pick(suggest[hi]); }
    if(e.key==="Escape"){    setSuggest([]); }
  }

  function pick(m){
    setSuggest([]);
    setQ(m.title);
    setRows([m]); // show the exact pick immediately
  }

  useEffect(()=>{
    function away(ev){ if(boxRef.current && !boxRef.current.contains(ev.target)) setSuggest([]); }
    document.addEventListener("click", away);
    return ()=>document.removeEventListener("click", away);
  },[]);

  return (
    <div className="container">
      <h1>Movies</h1>

      <div className="row center" style={{position:"relative"}} ref={boxRef}>
        <input className="input" placeholder="Search movies…"
               value={q} onChange={e=>onType(e.target.value)} onKeyDown={keyDown}/>
        <button className="btn" onClick={()=>go(q)}>Search</button>

        {suggest.length>0 && (
          <div className="suggest">
            {suggest.map((m,i)=>(
              <div key={m.id} className={`suggest-item ${i===hi? "active":""}`} onClick={()=>pick(m)}>
                <img alt={m.title} src={m.poster_path? TMDB_IMG+m.poster_path:""}/>
                <div className="flex1">{m.title}</div>
                <div className="muted">{(m.release_date||"").slice(0,4)}</div>
              </div>
            ))}
          </div>
        )}
      </div>

      {recent.length>0 && (
        <div className="row center" style={{margin:"10px 0"}}>
          <span className="muted">Recent:</span>
          {recent.map(r=><button key={r} className="btn" onClick={()=>{setQ(r);go(r);}}>{r}</button>)}
        </div>
      )}

      {loading && <div className="muted">Loading…</div>}

      <div className="grid">
        {rows.map(m=>(
          <div key={m.id} className="card tall">
            <div className="poster-wrap">
              {m.poster_path ? <img src={TMDB_IMG+m.poster_path} alt={m.title}/> : <div className="poster ph">No poster</div>}
            </div>
            <div className="card-body">
              <div className="title">{m.title}</div>
              <div className="row">
                <button className="btn"
                  onClick={()=>toggleFav({id:m.id, title:m.title, poster:m.poster_path? TMDB_IMG+m.poster_path:"", year:(m.release_date||"").slice(0,4)})}>
                  {favs.find(f=>f.id===m.id)? "★ Favorited":"☆ Favorite"}
                </button>
                <a className="btn" href={`https://www.imdb.com/find/?q=${encodeURIComponent(m.title)}`} target="_blank" rel="noreferrer">IMDB</a>
                <a className="btn" href={`https://www.themoviedb.org/movie/${m.id}`} target="_blank" rel="noreferrer">TMDB</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  );
}
